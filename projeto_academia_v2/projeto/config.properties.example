# Copie este arquivo para "config.properties" (ele é ignorado pelo Git) e preencha.
# Também é possível usar variáveis de ambiente com os mesmos nomes.

# Supabase -> botão "Connect" -> Session pooler -> aba JDBC
SUPABASE_DB_URL=jdbc:postgresql://aws-1-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=SUA_SENHA_DO_BANCO

# Upstash (ou Redis Cloud) -> Endpoint, Porta e Senha. Note o "rediss" (TLS)
REDIS_URL=rediss://default:SUA_SENHA@SEU_ENDPOINT.upstash.io:6379
